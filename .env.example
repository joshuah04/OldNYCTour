# === 뉴욕 나들이 environment variables ===
# Copy this file to .env.local and fill in the values.

# AI tour guide (Vercel AI Gateway). Get a key at:
# https://vercel.com/dashboard -> AI Gateway -> API Keys
# On Vercel deployments this is provided automatically via OIDC.
AI_GATEWAY_API_KEY=

# Google Maps Platform key used SERVER-SIDE for Places + Geocoding.
# Enable: "Places API (New)" and "Geocoding API".
# https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=

# Google Maps key used CLIENT-SIDE for the map view (Embed API).
# Enable: "Maps Embed API". Restrict this key by HTTP referrer.
# Can be the same project as above but should be a separate, referrer-restricted key.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
